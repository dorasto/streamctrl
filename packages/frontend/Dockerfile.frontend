# .dockerignore should be in the same directory as this Dockerfile
# and contain entries like:
# node_modules/
# dist/
# build/
# .git/
# .env
# etc.

# --- Stage 1: Base image for installing development dependencies ---
# This stage installs all (dev and prod) dependencies needed for building and type checking.
FROM node:20-alpine AS development_deps

WORKDIR /app

# Copy only package.json. Since package-lock.json is not committed, we omit it.
COPY package.json ./

# Install all dependencies (including devDependencies).
# `npm install` will resolve dependencies based on package.json and
# generate a new package-lock.json inside the container (which won't be used outside this stage).
RUN npm install

# --- Stage 2: Build the application ---
# This stage takes the development dependencies and the source code to produce the build output.
FROM node:20-alpine AS build_output

WORKDIR /app
# Copy package.json again for scripts access, and for npm to correctly identify the project.
COPY package.json ./
# Copy the node_modules from the development_deps stage.
COPY --from=development_deps /app/node_modules ./node_modules
# Copy all application source code.
COPY . .

# Run the build command as defined in package.json.
RUN npm run build

# --- Stage 3: Install production dependencies ---
# This stage installs only the production dependencies, resulting in a smaller node_modules.
FROM node:20-alpine AS production_deps

WORKDIR /app
# Copy package.json. Since package-lock.json is not committed, we omit it.
COPY package.json ./

# Install only production dependencies.
# `npm install --omit=dev` will resolve production dependencies based on package.json
# and generate a new package-lock.json inside the container.
RUN npm install --omit=dev

# --- Stage 4: Final production image (Runner) ---
# This is the leanest image, containing only what's necessary to run the application.
FROM node:20-alpine AS runner

WORKDIR /app

# Copy only the production-ready node_modules.
COPY --from=production_deps /app/node_modules ./node_modules

# Copy the built application from the build_output stage.
COPY --from=build_output /app/build ./build

# Copy package.json if your start script or application requires it at runtime
COPY package.json ./

# Define the command to start the application.
CMD ["npm", "run", "start"]

# Note on .env files:
# Docker builds typically do not embed .env files directly into the image for security.
# Environment variables should be passed at runtime using -e, --env-file, or through Kubernetes/orchestration.
# Your react-router-serve process (when run by Node.js) will automatically pick up system environment variables.