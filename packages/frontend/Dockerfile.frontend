# Stage 1: Install dependencies and build (without external package-lock.json)
FROM node:20-alpine AS builder

WORKDIR /app

# Copy only package.json first
COPY package.json ./

# !!! IMPORTANT: Use 'npm install' instead of 'npm ci' to generate the lock file.
# This will also generate package-lock.json in the current directory (/app)
RUN npm install

# Copy the rest of the application source code (now that node_modules is populated)
COPY . .

# Run the build script
RUN npm run build

# Stage 2: Create the final production image
FROM node:20-alpine AS production

WORKDIR /app

# Copy package.json (and the now-generated package-lock.json from the builder stage)
# This assumes that `npm install` in the builder stage successfully generated `package-lock.json`
# and it's present in /app in the builder stage.
COPY --from=builder /app/package.json ./
COPY --from=builder /app/package-lock.json ./

# Now you can use npm ci --omit=dev, as the lock file is present
RUN npm ci --omit=dev

# Copy the built application from the 'builder' stage
COPY --from=builder /app/build ./build

EXPOSE 3000

CMD ["npm", "run", "start"]