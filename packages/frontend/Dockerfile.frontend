# Stage 1: Install development dependencies and build the application
FROM node:20-alpine AS builder

WORKDIR /app

# Copy package.json and package-lock.json first to leverage Docker cache
# if only dependencies change, not source code.
COPY package*.json ./

# Install development and production dependencies
# 'npm ci' is preferred for CI/CD as it ensures exact versions from package-lock.json
RUN npm ci

# Copy the rest of the application source code
COPY . .

# Run the build script
# Ensure your build command outputs to a predictable directory, e.g., 'dist'
# If your build outputs to 'build', adjust the COPY command in the final stage.
RUN npm run build

# Stage 2: Create the final production image
FROM node:20-alpine AS production

WORKDIR /app

# Copy only package.json for production dependencies
COPY package*.json ./

# Install only production dependencies
RUN npm ci --omit=dev

# Copy the built application from the 'builder' stage
# Adjust '/app/build' if your build script outputs to a different directory (e.g., /app/dist)
COPY --from=builder /app/build ./build
# If your application needs source files in addition to the build output,
# you might need to copy specific source files, but typically the 'build'
# output should be self-contained for static assets/server bundles.

# Expose the port your application listens on (optional but good practice)
EXPOSE 3000

# Command to run your application
# Ensure your 'start' script correctly references the built files
CMD ["npm", "run", "start"]

# --- OPTIONAL: If your start script needs other files not in 'build' ---
# If your 'start' script directly relies on source files (e.g., a server
# that doesn't fully compile everything into 'build'), you might need to
# copy more files from the builder or from the host directly.
# Example: COPY --from=builder /app/src ./src
# However, the goal of a build step is usually to make the 'build' output
# self-sufficient.