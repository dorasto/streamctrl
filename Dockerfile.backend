# Use the Bun image as the base image
FROM oven/bun:latest

# Set the working directory in the container to the workspace root
WORKDIR /app

# Copy package.json, bun.lockb, and the packages directory
# This ensures the entire workspace structure is available
COPY package.json bun.lock ./
COPY packages packages/

# Install dependencies for the entire workspace
# This will install dependencies for all packages within 'packages/*'
RUN bun install

# Set the production environment
ENV NODE_ENV=production

# Navigate into the specific backend package for building and running
WORKDIR /app/packages/backend

# Run the build command for the backend package
# This assumes your 'backend' package has a 'build' script
# If your global "bun run build" from root builds everything, you might put this higher up,
# but it's safer to build the specific app if the main CMD is for that app.
RUN bun run build

# Expose the application port (Hono often defaults to 3000, but 4000 is fine if configured)
EXPOSE 4000

# Start the Hono application from its 'dist' folder within the backend package
# Assuming 'bun run build' in 'packages/backend' puts output in 'packages/backend/dist'
CMD ["bun", "dist/index.js"]