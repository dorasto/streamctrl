{
  "name": "streamctrl",
  "private": false,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "backend:start": "cd packages/backend && bun run index.ts",
    "frontend:dev": "cd packages/frontend && bun install && bun run dev",
    "db:studio": "cd packages/db && bun run studio",
    "dev:all": "concurrently \"bun:backend:start\" \"bun:frontend:dev\" \"bun:db:studio\""
  },
  "devDependencies": {
    "concurrently": "^9.2.0"
  }
}
