# File: Dockerfile.frontend

# --- Build Stage ---
FROM node:20-alpine AS build

# Set the working directory in the container to the workspace root
WORKDIR /app

# Copy global package.json and lockfile
COPY package.json ./
# IMPORTANT: If you're switching to NPM, remove bun.lockb from this copy unless you have a specific reason
# to keep it AND your npm is configured to use it (uncommon).
# So, REMOVE `bun.lockb` from the COPY list for now.
# COPY bun.lockb ./ # <-- COMMENT OR REMOVE THIS LINE if you're not using npm with bun.lockb

# Copy packages directory (needs to be available for workspace linking during install)
COPY packages packages/

# Ensure a clean slate for npm install
# Remove existing node_modules directories, both at root and within packages
RUN rm -rf node_modules packages/*/node_modules

# Try installing with --legacy-peer-deps for now if peer dependency conflicts are an issue
# Also, try --verbose to get more output
RUN npm install --verbose --legacy-peer-deps

# ... rest of your Dockerfile remains the same for now ...
# Set the production environment
ENV NODE_ENV=production

# Navigate into the specific frontend package for building
WORKDIR /app/packages/frontend

# Run the build command for the frontend package
RUN npm run build

# --- Production Stage ---
FROM node:20-alpine AS production

# Set the working directory
WORKDIR /app

# Copy only necessary files from the build stage
COPY --from=build /app/packages/frontend/build ./packages/frontend/build
COPY --from=build /app/packages/frontend/package.json ./packages/frontend/package.json
COPY --from=build /app/packages/frontend/node_modules ./packages/frontend/node_modules

# If your server requires `db` or `backend` code, you will need to copy those as well.
# Assuming build outputs are in `dist` or `build` in those packages
COPY --from=build /app/packages/backend/build ./packages/backend/build
COPY --from=build /app/packages/db/build ./packages/db/build

# Set the production environment
ENV NODE_ENV=production

# Expose the port your frontend server will listen on
EXPOSE 3000

# Define the command to start your frontend server
CMD ["node", "./packages/frontend/build/server/index.js"]