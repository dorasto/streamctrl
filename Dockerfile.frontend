# Stage 1: Build the frontend application
FROM oven/bun:latest AS frontend_builder

WORKDIR /app

# --- Declare build arguments from docker-compose.yml here ---
ARG VITE_WS_URL
ARG VITE_API_URL
# Declare any other ARGs passed from docker-compose.yml

# Make them available as ENV vars during the build process
# Frontend bundlers like Vite look for these in the build environment
ENV VITE_WS_URL=${VITE_WS_URL}
ENV VITE_API_URL=${VITE_API_URL}
ENV NODE_ENV=production

COPY package.json bun.lock ./
COPY packages/ packages/
RUN bun install

WORKDIR /app/packages/frontend
RUN bun run build # This command will now have VITE_WS_URL and VITE_API_URL in its environment


# Stage 2: Create the final production Bun image for the frontend
FROM oven/bun:latest AS production_frontend

WORKDIR /app

COPY --from=frontend_builder /app/package.json ./
COPY --from=frontend_builder /app/bun.lock ./
COPY --from=frontend_builder /app/packages/ packages/

WORKDIR /app/packages/frontend

RUN bun install --production

EXPOSE 3000

ENV NODE_ENV=production 

CMD ["bun", "run", "start"]