# Stage 1: Build the frontend application
FROM oven/bun:latest AS frontend_builder

# Set the overall project root as the initial working directory
WORKDIR /app

# Copy workspace configuration files
COPY package.json bun.lock ./

# Copy the entire packages directory to maintain workspace structure
COPY packages/ packages/

# Install dependencies for the entire workspace
RUN bun install

# Change working directory into the frontend package
WORKDIR /app/packages/frontend

# Run the build script for the frontend package
RUN bun run build


# Stage 2: Create the final production Bun image for the frontend
FROM oven/bun:latest AS production_frontend

# Set the overall project root as the initial working directory
WORKDIR /app

# Copy workspace configuration
COPY --from=frontend_builder /app/package.json ./
COPY --from=frontend_builder /app/bun.lock ./

# Copy the packages directory structure
COPY --from=frontend_builder /app/packages/ packages/

# Navigate into the frontend package
WORKDIR /app/packages/frontend

# Install production dependencies
RUN bun install --production

# Expose the application port
EXPOSE 3000

# Set production environment
ENV NODE_ENV=production

# Command to start the frontend application using bun
CMD ["bun", "run", "start"]